      "learner_decision_id": "LD-ONB2-PED-AOM-DX",
      "stem": "An otherwise healthy 18-month-old child has had new ear pain for 24 hours. Otoscopy shows a bulging tympanic membrane with markedly reduced mobility.",
      "lead_in": "Which diagnosis best explains this presentation?",
      "classification": "DEVELOPMENT_VALIDATION",
      "contrast_set_id": "CS-V6-AOM-DX-01",
      "options": [
        {
          "option_id": "A",
          "text": "Eustachian-tube dysfunction",
          "role": "DISTRACTOR"
        },
        {
          "option_id": "B",
          "text": "Viral myringitis",
          "role": "DISTRACTOR"
        },
        {
          "option_id": "C",
          "text": "Otitis media with effusion",
          "role": "DISTRACTOR"
        },
        {
          "option_id": "D",
          "text": "Acute otitis media",
          "role": "KEY"
        }
      ],
      "correct_option_id": "D",
