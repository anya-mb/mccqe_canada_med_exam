  "claim_cards": [
    {"claim_card_id":"FNDCLM-PHELO-011-01A","claim":"Public health is organized societal action that protects and promotes health through programs, services, and policies.","scope_references":[{"study_unit_id":"SU-PH-01"}],"citations":[{"document_id":"FNDOC-93E6B09ED27ED3F5","locator":"Chapter 2 > Public, and Population Health"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-01B","claim":"Population health is a conceptual framework for explaining why groups differ in health through individual and population determinants.","scope_references":[{"study_unit_id":"SU-PH-01"}],"citations":[{"document_id":"FNDOC-93E6B09ED27ED3F5","locator":"Chapter 2 > Population health"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-01C","claim":"Epidemiology is a core science used by population health to describe health status and explain disease causes in populations.","scope_references":[{"study_unit_id":"SU-PH-01"}],"citations":[{"document_id":"FNDOC-93E6B09ED27ED3F5","locator":"Chapter 2 > Population health"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-02A","claim":"Population health strategies are designed to affect groups or populations whereas clinical health care usually addresses individuals with a health problem or substantial risk.","scope_references":[{"study_unit_id":"SU-PH-01"}],"citations":[{"document_id":"FNDOC-93E6B09ED27ED3F5","locator":"Chapter 2 > Population health"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-06A","claim":"Illness is a person's subjective experience of feeling unwell rather than a specific pathology.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"FNDOC-4BEA0842A427919D","locator":"Chapter 1 > Illness, Sickness, and Disease"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-06B","claim":"Sickness refers to socially and culturally held conceptions of health conditions.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"FNDOC-4BEA0842A427919D","locator":"Chapter 1 > Illness, Sickness, and Disease"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-06C","claim":"Disease concerns pathological processes that may or may not cause symptoms and that result in illness.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"FNDOC-4BEA0842A427919D","locator":"Chapter 1 > Illness, Sickness, and Disease"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-07A","claim":"Health equity seeks to eliminate unfair and avoidable health differences whereas equality treats people the same.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"FNDOC-0DBFECC93E0794AC","locator":"Canada's Dietary Guidelines Glossary > Health equity"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-08A","claim":"Social and structural determinants shape living conditions and opportunities and can produce different health outcomes across communities.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"FNDOC-61886A09C5A98708","locator":"Health equity and determinants of health > Social determinants of health; Structural determinants of health"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-09A","claim":"Cultural awareness is acknowledgment of cultural difference without requiring reflection on one's own cultural perspective.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"SRDOC-0E9FEBFD1A9EFF15","locator":"Definitions > Cultural awareness"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-09B","claim":"Cultural sensitivity recognizes the need to respect cultural differences.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"SRDOC-0E9FEBFD1A9EFF15","locator":"Definitions > Cultural sensitivity"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-09C","claim":"Cultural competency requires self-reflection about how one's cultural values affect care and continued learning about another culture.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"SRDOC-0E9FEBFD1A9EFF15","locator":"Definitions > Cultural competency"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-09D","claim":"Cultural humility uses self-reflection to recognize personal and systemic bias and privilege and to build respectful relationships based on mutual trust.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"SRDOC-0E9FEBFD1A9EFF15","locator":"Definitions > Cultural humility"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-09E","claim":"Cultural safety is a patient experience and outcome of respectful engagement that addresses health-system power imbalances.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"SRDOC-0E9FEBFD1A9EFF15","locator":"Definitions > Cultural safety"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"},
    {"claim_card_id":"FNDCLM-PHELO-011-10A","claim":"In a patient interaction cultural humility requires treating oneself as a learner and working to dismantle power imbalances.","scope_references":[{"study_unit_id":"SU-PH-03"}],"citations":[{"document_id":"SRDOC-0E9FEBFD1A9EFF15","locator":"Definitions > Cultural humility"}],"use_classification":"STABLE_FACTUAL_SUPPORT","verification_status":"VERIFIED_COMPLETE"}
