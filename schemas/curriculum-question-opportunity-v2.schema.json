{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccqe.local/schemas/curriculum-question-opportunity-v2.schema.json",
  "title": "CURRICULUM_QUESTION_OPPORTUNITY_REGISTRY_V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "v1_registry_sha256",
    "enumeration_design",
    "raw_candidate_count",
    "exact_duplicates_collapsed",
    "semantic_near_duplicates_collapsed",
    "opportunities",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "scope": {"const": "CURRICULUM_QUESTION_OPPORTUNITY_REGISTRY_V2"},
    "v1_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "enumeration_design": {"type": "string", "minLength": 1},
    "semantic_adjudication_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_adjudication_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_candidate_count": {"type": "integer", "minimum": 1},
    "exact_duplicates_collapsed": {"type": "integer", "minimum": 0},
    "semantic_near_duplicates_collapsed": {"type": "integer", "minimum": 0},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version", "opportunity_id", "opportunity_fingerprint", "discipline",
          "study_unit_id", "study_unit", "clinical_object", "action_lemma",
          "learner_decision", "learner_decision_code", "opportunity_family",
          "response_class", "clinical_stage", "population_context", "severity_context",
          "MCC_dimension_of_care", "MCC_physician_activity", "MCC_objective_ids",
          "primary_reasoning_target", "primary_discriminator_type", "atomicity_verdict",
          "mcq_suitability", "suitability_basis", "review_status",
          "recommended_item_capacity", "generation_readiness", "provenance_type",
          "source_competency_key", "source_competency_text", "source_v1_opportunity_ids",
          "source_anchor_refs", "enumeration_rule_ids", "aliases", "variant_group_id"
        ],
        "properties": {
          "schema_version": {"const": "2.0"},
          "opportunity_id": {"type": "string", "pattern": "^QOP-V2-[0-9A-F]{12}$"},
          "opportunity_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "discipline": {"enum": ["MED", "PED", "OBGYN", "SURG", "PSY", "PHELO"]},
          "study_unit_id": {"type": "string", "minLength": 1},
          "study_unit": {"type": "string", "minLength": 1},
          "clinical_object": {"type": "string", "minLength": 1},
          "action_lemma": {"type": "string", "minLength": 1},
          "learner_decision": {"type": "string", "minLength": 1},
          "learner_decision_code": {"type": "string", "minLength": 1},
          "opportunity_family": {"type": "string", "minLength": 1},
          "response_class": {"type": "string", "minLength": 1},
          "clinical_stage": {"type": "string", "minLength": 1},
          "population_context": {"type": "string"},
          "severity_context": {"type": "string"},
          "MCC_dimension_of_care": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "MCC_physician_activity": {"type": "string", "minLength": 1},
          "MCC_objective_ids": {"type": "array", "items": {"type": "string"}},
          "primary_reasoning_target": {"type": "string", "minLength": 1},
          "primary_discriminator_type": {"type": "string", "minLength": 1},
          "atomicity_verdict": {"const": "ATOMIC"},
          "mcq_suitability": {"enum": ["MCQ_STRONG", "MCQ_ACCEPTABLE", "MCQ_WEAK", "NOT_SUITABLE_FOR_MC"]},
          "suitability_basis": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["APPROVED", "REVISE", "REJECT", "UNCERTAIN"]},
          "recommended_item_capacity": {"type": "integer", "minimum": 0, "maximum": 3},
          "generation_readiness": {"type": "string", "minLength": 1},
          "provenance_type": {"enum": ["V1_PRESERVED", "V2_NEW_FAMILY", "V2_STAGE_EXPANSION", "V2_POPULATION_EXPANSION", "V2_OTHER"]},
          "source_competency_key": {"type": "string", "minLength": 1},
          "source_competency_text": {"type": "string", "minLength": 1},
          "source_v1_opportunity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_anchor_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "enumeration_rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "variant_group_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
