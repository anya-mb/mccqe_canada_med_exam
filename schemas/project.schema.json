{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccqe-qbank.invalid/schemas/project.schema.json",
  "title": "Qbank project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_mode", "api_automated_enabled", "source", "limits", "blind_verification"],
  "properties": {
    "research_mode": {"enum": ["CODEX_NATIVE", "MANUAL_RESEARCH", "API_AUTOMATED"]},
    "api_automated_enabled": {"type": "boolean"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected_edition", "expected_pages", "expected_size_bytes", "expected_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expected_edition": {"type": "string", "minLength": 1},
        "expected_pages": {"type": "integer", "minimum": 1},
        "expected_size_bytes": {"type": "integer", "minimum": 1},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "verification", "maximum_revisions"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "verification": {"type": "integer", "minimum": 1},
        "maximum_revisions": {"type": "integer", "minimum": 0}
      }
    },
    "blind_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_confidence"],
      "properties": {
        "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
