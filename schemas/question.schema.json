{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccqe-qbank.invalid/schemas/question.schema.json",
  "title": "Canonical qbank question",
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "answerKey": {"enum": ["A", "B", "C", "D", "E"]},
    "status": {"enum": ["DRAFT", "CANDIDATE", "STRUCTURE_PASS", "BLIND_PASS", "MEDICAL_PASS", "QA_PASS", "PUBLISHED", "QUARANTINE", "REVISED", "REJECTED", "HUMAN_REVIEWED", "RETIRED"]},
    "verificationStatus": {"enum": ["PENDING", "BLIND_PASS", "MEDICAL_PASS", "QA_PASS", "HUMAN_REVIEWED", "QUARANTINE", "REJECTED"]},
    "torontoNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "chapter", "chapter_code", "section", "subsection", "tn_pages", "pdf_pages"],
      "properties": {
        "edition": {"$ref": "#/$defs/nonempty"},
        "chapter": {"$ref": "#/$defs/nonempty"},
        "chapter_code": {"$ref": "#/$defs/nonempty"},
        "section": {"$ref": "#/$defs/nonempty"},
        "subsection": {"$ref": "#/$defs/nonempty"},
        "tn_pages": {"$ref": "#/$defs/nonempty"},
        "pdf_pages": {"$ref": "#/$defs/nonempty"}
      }
    },
    "mcc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectives", "physician_activity", "dimension_of_care"],
      "properties": {
        "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "physician_activity": {"$ref": "#/$defs/nonempty"},
        "dimension_of_care": {"$ref": "#/$defs/nonempty"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/answerKey"},
        "text": {"$ref": "#/$defs/nonempty"}
      }
    },
    "options": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/option"}, {"properties": {"id": {"const": "A"}}}]},
        {"allOf": [{"$ref": "#/$defs/option"}, {"properties": {"id": {"const": "B"}}}]},
        {"allOf": [{"$ref": "#/$defs/option"}, {"properties": {"id": {"const": "C"}}}]},
        {"allOf": [{"$ref": "#/$defs/option"}, {"properties": {"id": {"const": "D"}}}]},
        {"allOf": [{"$ref": "#/$defs/option"}, {"properties": {"id": {"const": "E"}}}]}
      ],
      "items": false
    },
    "distractorsForA": {"type": "object", "additionalProperties": false, "required": ["B", "C", "D", "E"], "properties": {"B": {"$ref": "#/$defs/nonempty"}, "C": {"$ref": "#/$defs/nonempty"}, "D": {"$ref": "#/$defs/nonempty"}, "E": {"$ref": "#/$defs/nonempty"}}},
    "distractorsForB": {"type": "object", "additionalProperties": false, "required": ["A", "C", "D", "E"], "properties": {"A": {"$ref": "#/$defs/nonempty"}, "C": {"$ref": "#/$defs/nonempty"}, "D": {"$ref": "#/$defs/nonempty"}, "E": {"$ref": "#/$defs/nonempty"}}},
    "distractorsForC": {"type": "object", "additionalProperties": false, "required": ["A", "B", "D", "E"], "properties": {"A": {"$ref": "#/$defs/nonempty"}, "B": {"$ref": "#/$defs/nonempty"}, "D": {"$ref": "#/$defs/nonempty"}, "E": {"$ref": "#/$defs/nonempty"}}},
    "distractorsForD": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "E"], "properties": {"A": {"$ref": "#/$defs/nonempty"}, "B": {"$ref": "#/$defs/nonempty"}, "C": {"$ref": "#/$defs/nonempty"}, "E": {"$ref": "#/$defs/nonempty"}}},
    "distractorsForE": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"], "properties": {"A": {"$ref": "#/$defs/nonempty"}, "B": {"$ref": "#/$defs/nonempty"}, "C": {"$ref": "#/$defs/nonempty"}, "D": {"$ref": "#/$defs/nonempty"}}},
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_summary", "clinical_reasoning", "key_clues", "why_correct", "distractor_rationales", "clinical_pearl"],
      "properties": {
        "answer_summary": {"$ref": "#/$defs/nonempty"},
        "clinical_reasoning": {"$ref": "#/$defs/nonempty"},
        "key_clues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "why_correct": {"$ref": "#/$defs/nonempty"},
        "distractor_rationales": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "A": {"$ref": "#/$defs/nonempty"},
            "B": {"$ref": "#/$defs/nonempty"},
            "C": {"$ref": "#/$defs/nonempty"},
            "D": {"$ref": "#/$defs/nonempty"},
            "E": {"$ref": "#/$defs/nonempty"}
          }
        },
        "what_happens_next": {"$ref": "#/$defs/nonempty"},
        "clinical_pearl": {"$ref": "#/$defs/nonempty"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_packet_complete", "blind_verifier_answer", "blind_verifier_confidence", "key_match", "ambiguity", "reference_check", "guideline_check", "duplicate_check", "final_status"],
      "properties": {
        "source_packet_complete": {"type": "boolean"},
        "blind_verifier_answer": {"anyOf": [{"$ref": "#/$defs/answerKey"}, {"type": "null"}]},
        "blind_verifier_confidence": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
        "key_match": {"type": ["boolean", "null"]},
        "ambiguity": {"type": ["boolean", "null"]},
        "reference_check": {"type": ["boolean", "null"]},
        "guideline_check": {"type": ["boolean", "null"]},
        "duplicate_check": {"type": ["boolean", "null"]},
        "final_status": {"$ref": "#/$defs/verificationStatus"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "discipline", "chapter", "subtopic", "toronto_notes", "toronto_notes_gap_fill", "guideline_updated_since_tn2025", "mcc", "difficulty", "question", "correct_answer", "explanation", "references", "verification", "content_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "status": {"$ref": "#/$defs/status"},
    "discipline": {"$ref": "#/$defs/nonempty"},
    "chapter": {"$ref": "#/$defs/nonempty"},
    "subtopic": {"$ref": "#/$defs/nonempty"},
    "toronto_notes": {"$ref": "#/$defs/torontoNotes"},
    "toronto_notes_gap_fill": {"type": "boolean"},
    "guideline_updated_since_tn2025": {"type": "boolean"},
    "mcc": {"$ref": "#/$defs/mcc"},
    "difficulty": {"enum": ["easy", "moderate", "difficult"]},
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "lead_in", "options"],
      "properties": {
        "stem": {"$ref": "#/$defs/nonempty"},
        "lead_in": {"$ref": "#/$defs/nonempty"},
        "options": {"$ref": "#/$defs/options"}
      }
    },
    "correct_answer": {"$ref": "#/$defs/answerKey"},
    "explanation": {"$ref": "#/$defs/explanation"},
    "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^REF-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}},
    "verification": {"$ref": "#/$defs/verification"},
    "content_version": {"$ref": "#/$defs/nonempty"}
  },
  "allOf": [
    {"if": {"properties": {"correct_answer": {"const": "A"}}, "required": ["correct_answer"]}, "then": {"properties": {"explanation": {"properties": {"distractor_rationales": {"$ref": "#/$defs/distractorsForA"}}}}}},
    {"if": {"properties": {"correct_answer": {"const": "B"}}, "required": ["correct_answer"]}, "then": {"properties": {"explanation": {"properties": {"distractor_rationales": {"$ref": "#/$defs/distractorsForB"}}}}}},
    {"if": {"properties": {"correct_answer": {"const": "C"}}, "required": ["correct_answer"]}, "then": {"properties": {"explanation": {"properties": {"distractor_rationales": {"$ref": "#/$defs/distractorsForC"}}}}}},
    {"if": {"properties": {"correct_answer": {"const": "D"}}, "required": ["correct_answer"]}, "then": {"properties": {"explanation": {"properties": {"distractor_rationales": {"$ref": "#/$defs/distractorsForD"}}}}}},
    {"if": {"properties": {"correct_answer": {"const": "E"}}, "required": ["correct_answer"]}, "then": {"properties": {"explanation": {"properties": {"distractor_rationales": {"$ref": "#/$defs/distractorsForE"}}}}}}
  ]
}
