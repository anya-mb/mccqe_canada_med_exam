{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccqe.local/schemas/curriculum-question-opportunity-v1.schema.json",
  "title": "CURRICULUM_QUESTION_OPPORTUNITY_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_id", "discipline", "chapter_code", "chapter_title",
    "section_path", "study_unit_id", "study_unit", "clinical_topic",
    "key_concept_or_action", "learner_decision", "learner_decision_code",
    "opportunity_family", "response_class", "clinical_stage",
    "population_context", "severity_context", "MCC_dimension_of_care",
    "MCC_physician_activity", "MCC_objective_ids", "primary_reasoning_target",
    "primary_discriminator_type", "difficulty_potential", "source_anchor_refs",
    "source_study_unit_ids", "source_chapter_refs", "aliases", "scope_status",
    "generation_readiness", "parent_opportunity_family", "variant_group_id",
    "opportunity_fingerprint", "review_status", "review_error_taxonomy",
    "mcq_suitability", "importance", "recommended_item_capacity",
    "capacity_rationale", "supported_difficulty_levels", "validation_item_refs"
  ],
  "properties": {
    "opportunity_id": {"type": "string", "pattern": "^QOP-CURR-[0-9A-F]{12}$"},
    "discipline": {"enum": ["MED", "PED", "OBGYN", "SURG", "PSY", "PHELO"]},
    "chapter_code": {"type": "string", "minLength": 1},
    "chapter_title": {"type": "string", "minLength": 1},
    "section_path": {"type": "array", "items": {"type": "string"}},
    "study_unit_id": {"type": "string", "minLength": 1},
    "study_unit": {"type": "string", "minLength": 1},
    "clinical_topic": {"type": "string", "minLength": 1},
    "key_concept_or_action": {"type": "string", "minLength": 1},
    "learner_decision": {"type": "string", "minLength": 1},
    "learner_decision_code": {"type": "string", "minLength": 1},
    "opportunity_family": {"type": "string", "minLength": 1},
    "response_class": {"type": "string", "minLength": 1},
    "clinical_stage": {"type": "string", "minLength": 1},
    "population_context": {"type": "string"},
    "severity_context": {"type": "string"},
    "MCC_dimension_of_care": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "MCC_physician_activity": {"type": "string", "minLength": 1},
    "MCC_objective_ids": {"type": "array", "items": {"type": "string"}},
    "primary_reasoning_target": {"type": "string", "minLength": 1},
    "primary_discriminator_type": {"type": "string", "minLength": 1},
    "difficulty_potential": {"type": "array", "items": {"enum": ["EASY", "MEDIUM", "HARD"]}},
    "source_anchor_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_study_unit_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_chapter_refs": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scope_status": {"enum": ["CORE_ACTION", "RECOGNIZE_AND_ACT", "RECOGNIZE", "CONTEXT_ONLY", "OUT_OF_SCOPE_DETAIL"]},
    "generation_readiness": {"enum": ["READY_EXISTING_BUNDLE", "READY_EXISTING_CANDIDATES_NEEDS_SEED", "READY_ON_DEMAND_EXPANSION", "NEEDS_CANDIDATE_EXPANSION", "NEEDS_EVIDENCE", "INSUFFICIENT_SAFE_DISTRACTORS", "UNSUITABLE_FOR_MC", "DEFERRED_OTHER"]},
    "parent_opportunity_family": {"type": "string", "minLength": 1},
    "variant_group_id": {"type": "string", "minLength": 1},
    "opportunity_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_status": {"enum": ["APPROVED", "REVISE", "REJECT", "UNCERTAIN"]},
    "review_error_taxonomy": {"type": "array", "items": {"type": "string"}},
    "mcq_suitability": {"enum": ["MCQ_STRONG", "MCQ_ACCEPTABLE", "MCQ_WEAK", "NOT_SUITABLE_FOR_MC"]},
    "importance": {"enum": ["CORE", "HIGH", "STANDARD", "SUPPORTING"]},
    "recommended_item_capacity": {"type": "integer", "minimum": 0, "maximum": 3},
    "capacity_rationale": {"type": "array", "items": {"type": "string"}},
    "supported_difficulty_levels": {"type": "array", "items": {"enum": ["EASY", "MEDIUM", "HARD"]}},
    "validation_item_refs": {"type": "array", "items": {"type": "string"}}
  }
}
