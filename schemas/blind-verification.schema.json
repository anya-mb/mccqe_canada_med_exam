{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mccqe-qbank.invalid/schemas/blind-verification.schema.json",
  "title": "Independent blind verification result",
  "$defs": {
    "answerKey": {"enum": ["A", "B", "C", "D", "E"]},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "independent_answer", "confidence", "single_best_answer", "other_defensible_options", "stem_sufficient", "guideline_support", "uncertainty_concern", "recommendation", "verifier_role", "verified_at"],
  "properties": {
    "question_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$"},
    "independent_answer": {"$ref": "#/$defs/answerKey"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "single_best_answer": {"type": "boolean"},
    "other_defensible_options": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/answerKey"}},
    "stem_sufficient": {"type": "boolean"},
    "guideline_support": {"type": "boolean"},
    "uncertainty_concern": {"type": ["string", "null"], "minLength": 1},
    "recommendation": {"enum": ["PASS", "QUARANTINE", "REJECT"]},
    "verifier_role": {"type": "string", "minLength": 1},
    "verified_at": {"$ref": "#/$defs/timestamp"}
  }
}
