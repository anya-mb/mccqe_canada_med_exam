{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "total_target_questions",
    "discipline_targets",
    "excludes_full_exam_simulation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scope": {
      "const": "FINAL_MCCQE_QUESTION_BANK"
    },
    "total_target_questions": {
      "type": "integer",
      "minimum": 1
    },
    "discipline_targets": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 6,
      "maxProperties": 6,
      "required": ["MED", "OBGYN", "PED", "PHELO", "PSY", "SURG"],
      "properties": {
        "MED": {"type": "integer", "minimum": 1},
        "OBGYN": {"type": "integer", "minimum": 1},
        "PED": {"type": "integer", "minimum": 1},
        "PHELO": {"type": "integer", "minimum": 1},
        "PSY": {"type": "integer", "minimum": 1},
        "SURG": {"type": "integer", "minimum": 1}
      }
    },
    "excludes_full_exam_simulation": {
      "const": true
    }
  }
}
